<section id="hero" class="relative min-h-screen pt-32 pb-20 flex items-center overflow-hidden">
  <!-- Background Radial Ambient Glows -->
  <div class="absolute top-1/4 left-10 w-96 h-96 rounded-full radial-glow-teal pointer-events-none"></div>
  <div class="absolute bottom-10 right-10 w-[30rem] h-[30rem] rounded-full radial-glow-cyan pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Hero Content Column -->
      <div class="lg:col-span-7 flex flex-col items-start" data-controller="reveal" data-reveal-stagger-value="0.15">
        
        <!-- Status Availability Pill -->
        <div data-reveal-target="item" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-medium text-teal-400 bg-teal-500/10 border border-teal-500/20 mb-6 backdrop-blur-sm">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-teal-500"></span>
          </span>
          <span>Available for New Roles & Projects</span>
        </div>

        <!-- Name & Title -->
        <h1 data-reveal-target="item" class="font-display font-extrabold text-4xl sm:text-6xl lg:text-7xl tracking-tight text-white leading-none mb-4">
          B. Bala <span class="bg-gradient-to-r from-teal-400 via-cyan-400 to-emerald-400 bg-clip-text text-transparent">Bharathi</span>
        </h1>

        <h2 data-reveal-target="item" class="font-display font-semibold text-xl sm:text-2xl text-teal-400/90 mb-6 tracking-wide flex items-center gap-3">
          <span>Ruby on Rails Developer</span>
          <span class="text-xs px-2.5 py-1 rounded-md bg-slate-800 border border-slate-700 text-slate-300 font-mono">2 Yrs Exp</span>
        </h2>

        <!-- Summary Description -->
        <p data-reveal-target="item" class="text-slate-300 text-base sm:text-lg leading-relaxed mb-8 max-w-2xl font-light">
          Ruby on Rails Developer with 2 years of experience building, maintaining, and supporting production web applications — skilled in troubleshooting, root cause analysis, API debugging, database optimization and performance tuning, working with <strong class="text-white font-medium">Ruby on Rails, MySQL, RESTful APIs</strong> and <strong class="text-white font-medium">Linux environments</strong>.
        </p>

        <!-- Quick Meta Details -->
        <div data-reveal-target="item" class="flex flex-wrap items-center gap-y-3 gap-x-6 text-xs sm:text-sm text-slate-400 mb-10 font-mono">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span>Sivakasi, Tamil Nadu, India</span>
          </div>

          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <a href="mailto:bharathibala179@gmail.com" class="hover:text-teal-400 transition-colors">bharathibala179@gmail.com</a>
          </div>

          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <a href="tel:+919361985078" class="hover:text-teal-400 transition-colors">+91 9361985078</a>
          </div>
        </div>

        <!-- Action Call To Actions -->
        <div data-reveal-target="item" class="flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <a href="#projects" class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl text-sm font-semibold text-slate-950 bg-gradient-to-r from-teal-400 to-cyan-400 hover:from-teal-300 hover:to-cyan-300 transition-all shadow-lg shadow-teal-500/25 hover:shadow-teal-500/40 hover:-translate-y-0.5">
            <span>View Projects</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <a href="#contact" class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl text-sm font-semibold text-slate-200 bg-slate-800/80 border border-slate-700/80 hover:bg-slate-800 hover:border-slate-600 transition-all hover:-translate-y-0.5">
            <span>Contact Me</span>
          </a>

          <a href="/Bala_Bharathi_Resume.pdf" download class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl text-sm font-medium text-teal-400 bg-teal-500/10 border border-teal-500/30 hover:bg-teal-500/20 hover:border-teal-500/50 transition-all">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <span>Resume</span>
          </a>
        </div>
      </div>

      <!-- Right Column: SIGNATURE ID LANYARD BADGE ANIMATION -->
      <div class="lg:col-span-5 flex justify-center items-center relative py-12" data-controller="id-card">
        
        <!-- Pinned Top Lanyard Ring -->
        <div class="absolute -top-10 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center">
          <div class="w-6 h-6 rounded-full border-2 border-teal-400/80 bg-slate-900 shadow-md flex items-center justify-center">
            <div class="w-2 h-2 rounded-full bg-teal-400"></div>
          </div>
          <div data-id-card-target="lanyard" class="lanyard-string h-24"></div>
          <div class="lanyard-clip"></div>
        </div>

        <!-- Hanging Photo ID Card Badge -->
        <div data-id-card-target="card" class="relative z-10 w-72 sm:w-80 rounded-2xl p-6 glass-card id-badge-shadow cursor-grab active:cursor-grabbing border border-slate-700/60 bg-gradient-to-b from-slate-900/90 via-slate-900/95 to-slate-950">
          
          <!-- Lanyard Hole Slot Clip Header -->
          <div class="flex items-center justify-between border-b border-slate-800 pb-4 mb-5">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-teal-400 shadow-[0_0_8px_rgba(45,212,191,0.8)]"></div>
              <span class="font-mono text-[10px] text-slate-400 uppercase tracking-widest">NED TECH PRO PASS</span>
            </div>
            <div class="w-8 h-2 rounded-full bg-slate-800 border border-slate-700"></div>
          </div>

          <!-- Profile Photo -->
          <div class="relative w-44 h-44 mx-auto mb-5 rounded-2xl overflow-hidden p-1 bg-gradient-to-tr from-teal-400 to-cyan-400 shadow-xl shadow-teal-500/20">
            <%= image_tag "profile.jpg", alt: "B. Bala Bharathi", class: "w-full h-full object-cover rounded-xl" %>
            <div class="absolute inset-0 rounded-xl ring-1 ring-inset ring-white/20"></div>
          </div>

          <!-- Card Info Details -->
          <div class="text-center">
            <h3 class="font-display font-bold text-xl text-white tracking-tight">B. Bala Bharathi</h3>
            <p class="text-xs font-mono text-teal-400 font-semibold uppercase tracking-wider mb-3">Ruby on Rails Developer</p>
            
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-slate-800/80 border border-slate-700 text-[11px] font-mono text-slate-300">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              <span>Associate ID: 052024</span>
            </div>
          </div>

          <!-- Barcode Footer Decor -->
          <div class="mt-5 pt-4 border-t border-slate-800/80 flex items-center justify-between">
            <div class="flex gap-1 h-6 items-center">
              <span class="w-1 h-full bg-slate-600"></span>
              <span class="w-0.5 h-full bg-slate-700"></span>
              <span class="w-1.5 h-full bg-slate-500"></span>
              <span class="w-0.5 h-full bg-slate-600"></span>
              <span class="w-2 h-full bg-slate-400"></span>
              <span class="w-1 h-full bg-slate-700"></span>
              <span class="w-0.5 h-full bg-slate-500"></span>
              <span class="w-1.5 h-full bg-slate-600"></span>
            </div>
            <span class="font-mono text-[10px] text-slate-500 tracking-widest">VERIFIED dev</span>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
