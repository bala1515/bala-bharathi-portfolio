<section id="contact" class="py-24 relative overflow-hidden bg-slate-950/60 border-t border-slate-800/60">
  <!-- Radial Glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[35rem] h-[35rem] rounded-full radial-glow-teal pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Heading -->
    <div class="flex flex-col items-start mb-16" data-controller="reveal">
      <span data-reveal-target="item" class="text-xs font-mono font-semibold uppercase tracking-widest text-teal-400 mb-2">05 // GET IN TOUCH</span>
      <h2 data-reveal-target="item" class="font-display font-extrabold text-3xl sm:text-5xl text-white tracking-tight">
        Let's Build Something Great Together
      </h2>
    </div>

    <!-- Flash Messages Output -->
    <% if flash[:notice].present? %>
      <div class="mb-8 p-4 rounded-xl bg-teal-500/10 border border-teal-500/30 text-teal-300 text-sm font-mono flex items-center gap-3 animate-fadeIn">
        <span class="w-2 h-2 rounded-full bg-teal-400 animate-ping"></span>
        <span><%= flash[:notice] %></span>
      </div>
    <% end %>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start" data-controller="reveal" data-reveal-stagger-value="0.15">
      
      <!-- Left Column: Contact Direct Information -->
      <div class="lg:col-span-5 space-y-8">
        <div data-reveal-target="item" class="glass-card p-8 rounded-3xl space-y-6">
          <h3 class="font-display font-bold text-xl text-white border-b border-slate-800 pb-4">
            Direct Contact Channels
          </h3>

          <!-- Phone -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-teal-500/10 border border-teal-500/20 flex items-center justify-center text-teal-400 shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
            </div>
            <div>
              <span class="text-xs font-mono text-slate-400 uppercase tracking-wider block mb-0.5">Phone Call / WhatsApp</span>
              <a href="tel:+919361985078" class="font-mono text-base font-semibold text-white hover:text-teal-400 transition-colors">
                +91 9361985078
              </a>
            </div>
          </div>

          <!-- Email -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <div>
              <span class="text-xs font-mono text-slate-400 uppercase tracking-wider block mb-0.5">Email Address</span>
              <a href="mailto:bharathibala179@gmail.com" class="font-mono text-base font-semibold text-white hover:text-cyan-400 transition-colors">
                bharathibala179@gmail.com
              </a>
            </div>
          </div>

          <!-- Location -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div>
              <span class="text-xs font-mono text-slate-400 uppercase tracking-wider block mb-0.5">Location</span>
              <span class="font-mono text-sm text-slate-200 block">
                Sivakasi, Tamil Nadu, 626124, India
              </span>
            </div>
          </div>
        </div>

        <!-- Social Media Profiles -->
        <div data-reveal-target="item" class="glass-card p-6 rounded-3xl">
          <span class="text-xs font-mono uppercase tracking-wider text-slate-400 block mb-4">Connect Socially</span>
          <div class="flex items-center gap-4">
            <%# TODO: replace with my real LinkedIn and GitHub profile URLs %>
            <a href="#" target="_blank" rel="noopener" class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-slate-900 border border-slate-800 text-xs font-mono font-medium text-slate-300 hover:text-white hover:border-teal-500/40 hover:bg-slate-800 transition-all">
              <svg class="w-4 h-4 text-teal-400" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.74a1.6 1.6 0 1 0 0 3.2 1.6 1.6 0 0 0 0-3.2Z"/>
              </svg>
              <span>LinkedIn</span>
            </a>

            <a href="#" target="_blank" rel="noopener" class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-slate-900 border border-slate-800 text-xs font-mono font-medium text-slate-300 hover:text-white hover:border-teal-500/40 hover:bg-slate-800 transition-all">
              <svg class="w-4 h-4 text-teal-400" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
              </svg>
              <span>GitHub</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Rails Contact Form -->
      <div class="lg:col-span-7">
        <div data-reveal-target="item" class="glass-card p-8 rounded-3xl">
          <h3 class="font-display font-bold text-2xl text-white mb-2">Send Me a Message</h3>
          <p class="text-slate-400 text-sm font-light mb-6">
            Have a project in mind, production issue to solve, or Rails opportunity? Fill in your details below.
          </p>

          <%= form_with(url: contact_path, method: :post, local: true, class: "space-y-6") do |f| %>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <%= f.label :name, "Your Name", class: "block text-xs font-mono uppercase tracking-wider text-slate-300 mb-2" %>
                <%= f.text_field :name, placeholder: "John Doe", required: true, class: "w-full px-4 py-3 rounded-xl bg-slate-900/90 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500 transition-all font-sans" %>
              </div>

              <div>
                <%= f.label :email, "Email Address", class: "block text-xs font-mono uppercase tracking-wider text-slate-300 mb-2" %>
                <%= f.email_field :email, placeholder: "john@example.com", required: true, class: "w-full px-4 py-3 rounded-xl bg-slate-900/90 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500 transition-all font-sans" %>
              </div>
            </div>

            <div>
              <%= f.label :message, "Message", class: "block text-xs font-mono uppercase tracking-wider text-slate-300 mb-2" %>
              <%= f.text_area :message, rows: 5, placeholder: "Tell me about your project, technology stack, or inquiry...", required: true, class: "w-full px-4 py-3 rounded-xl bg-slate-900/90 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500 transition-all font-sans resize-none" %>
            </div>

            <button type="submit" class="w-full sm:w-auto px-8 py-4 rounded-xl font-display font-semibold text-sm text-slate-950 bg-gradient-to-r from-teal-400 to-cyan-400 hover:from-teal-300 hover:to-cyan-300 transition-all shadow-lg shadow-teal-500/20 hover:shadow-teal-500/35 hover:-translate-y-0.5 inline-flex items-center justify-center gap-2">
              <span>Send Message</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
              </svg>
            </button>
          <% end %>
        </div>
      </div>

    </div>

  </div>
</section>
